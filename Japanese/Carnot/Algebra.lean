import Mathlib

/-!
# Polynomial identities behind Carnot's theorem

Pure real algebra. Coordinates: a triangle `p₀ p₁ p₂` with `u = p₁ - p₀`, `v = p₂ - p₀`,
side lengths `a = |p₁p₂|`, `b = |p₀p₂|`, `c = |p₀p₁|`, so `⟪u,u⟫ = c²`, `⟪v,v⟫ = b²`,
`⟪u,v⟫ = (b² + c² - a²)/2`, and `qf a b c p q = ‖p • u + q • v‖²`.
The circumcentre is `p₀ + x u + y v` with circumradius `R`; `k` is twice the area.
`qf`, `heron` and `circ_relation` are taken from the Feuerbach development; the other
`linear_combination` certificates were generated by `code/gen2.py` and `code/gen3.py`.
-/

namespace Carnot

/-- The squared norm of `p • u + q • v` in terms of the side lengths. -/
noncomputable def qf (a b c p q : ℝ) : ℝ :=
  p ^ 2 * c ^ 2 + p * q * (b ^ 2 + c ^ 2 - a ^ 2) + q ^ 2 * b ^ 2

/-- Heron's expression for `(2 · area)²`. -/
noncomputable def heron (a b c : ℝ) : ℝ :=
  (2 * a ^ 2 * b ^ 2 + 2 * b ^ 2 * c ^ 2 + 2 * c ^ 2 * a ^ 2 - a ^ 4 - b ^ 4 - c ^ 4) / 4

theorem circ_relation (a b c x y R : ℝ) (hx0 : R ^ 2 = qf a b c (0 - x) (0 - y))
    (hx1 : R ^ 2 = qf a b c (1 - x) (0 - y)) (hx2 : R ^ 2 = qf a b c (0 - x) (1 - y)) :
    4 * heron a b c * R ^ 2 = a ^ 2 * b ^ 2 * c ^ 2 := by
  simp only [qf, heron] at *
  linear_combination (a^4*x - a^4 - 3*a^2*b^2*y + 2*a^2*b^2 - a^2*c^2*x + a^2*c^2 - b^4*x - b^4*y + b^4 + b^2*c^2*x + b^2*c^2*y - b^2*c^2) * hx0 + (-a^4*x + a^2*b^2*y + 2*a^2*c^2*x + b^4*x + 3*b^4*y - 2*b^4 + 2*b^2*c^2*x - b^2*c^2*y + b^2*c^2 - c^4*x) * hx1 + (2*a^2*b^2*y - a^2*c^2*x + a^2*c^2 - 2*b^4*y - 3*b^2*c^2*x + 2*b^2*c^2 + c^4*x - c^4) * hx2

/-- The key polynomial identity: with barycentric circumcentre weights `(1-x-y, x, y)`,
`(w₀ bc + w₁ ca + w₂ ab)(a+b+c) = 2R²(a+b+c) + abc`. -/
theorem carnot_poly (a b c x y R : ℝ) (hx0 : R ^ 2 = qf a b c (0 - x) (0 - y))
    (hx1 : R ^ 2 = qf a b c (1 - x) (0 - y)) (hx2 : R ^ 2 = qf a b c (0 - x) (1 - y)) :
    ((1 - x - y) * b * c + x * a * c + y * a * b) * (a + b + c) =
      2 * R ^ 2 * (a + b + c) + a * b * c := by
  simp only [qf] at *
  linear_combination (a*x + a*y - 2*a + b*x + b*y - b + c*x + c*y - c) * hx0 + (-a*x - b*x - b - c*x) * hx1 + (-a*y - b*y - c*y - c) * hx2

/-- Carnot's theorem in coordinates. -/
theorem carnot_alg (a b c x y R k : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hR : 0 < R)
    (hx0 : R ^ 2 = qf a b c (0 - x) (0 - y))
    (hx1 : R ^ 2 = qf a b c (1 - x) (0 - y)) (hx2 : R ^ 2 = qf a b c (0 - x) (1 - y))
    (hRk : 2 * k * R = a * b * c) :
    (1 - x - y) * (k / a) + x * (k / b) + y * (k / c) = R + k / (a + b + c) := by
  have hS := carnot_poly a b c x y R hx0 hx1 hx2
  have hD : 0 < a + b + c := by positivity
  have hk : k = a * b * c / (2 * R) := by
    rw [eq_div_iff (by positivity)]; linear_combination hRk
  subst hk
  have e : (1 - x - y) * (a * b * c / (2 * R) / a) + x * (a * b * c / (2 * R) / b) +
      y * (a * b * c / (2 * R) / c) - (R + a * b * c / (2 * R) / (a + b + c)) =
      (((1 - x - y) * b * c + x * a * c + y * a * b) * (a + b + c) -
        (2 * R ^ 2 * (a + b + c) + a * b * c)) / (2 * R * (a + b + c)) := by
    field_simp
  rw [hS, sub_self, zero_div] at e
  exact sub_eq_zero.1 e

theorem cos0_poly (a b c x y R : ℝ) (hx0 : R ^ 2 = qf a b c (0 - x) (0 - y))
    (hx1 : R ^ 2 = qf a b c (1 - x) (0 - y)) (hx2 : R ^ 2 = qf a b c (0 - x) (1 - y)) :
    (1 - x - y) * b ^ 2 * c ^ 2 = R ^ 2 * (b ^ 2 + c ^ 2 - a ^ 2) := by
  simp only [qf] at *
  linear_combination (-a^2*x + a^2 + b^2*x + b^2*y - b^2) * hx0 + (a^2*x - b^2*x - b^2*y - c^2*x) * hx1 + (c^2*(x - 1)) * hx2

theorem cos1_poly (a b c x y R : ℝ) (hx0 : R ^ 2 = qf a b c (0 - x) (0 - y))
    (hx1 : R ^ 2 = qf a b c (1 - x) (0 - y)) (hx2 : R ^ 2 = qf a b c (0 - x) (1 - y)) :
    x * a ^ 2 * c ^ 2 = R ^ 2 * (a ^ 2 + c ^ 2 - b ^ 2) := by
  simp only [qf] at *
  linear_combination (a^2*(y - 1)) * hx0 + (-b^2*y + b^2 - c^2*x) * hx1 + (-a^2*y + b^2*y + c^2*x - c^2) * hx2

theorem cos2_poly (a b c x y R : ℝ) (hx0 : R ^ 2 = qf a b c (0 - x) (0 - y))
    (hx1 : R ^ 2 = qf a b c (1 - x) (0 - y)) (hx2 : R ^ 2 = qf a b c (0 - x) (1 - y)) :
    y * a ^ 2 * b ^ 2 = R ^ 2 * (a ^ 2 + b ^ 2 - c ^ 2) := by
  simp only [qf] at *
  linear_combination (a^2*(x - 1)) * hx0 + (-a^2*x + b^2*y - b^2 + c^2*x) * hx1 + (-b^2*y - c^2*x + c^2) * hx2

/-- From `w · b²c² = R² N` and `2kR = abc` get `w · (k / a) = R · (N / (2bc))`. -/
theorem weight_height_eq (a b c w R k N : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hR : 0 < R) (hw : w * b ^ 2 * c ^ 2 = R ^ 2 * N) (hRk : 2 * k * R = a * b * c) :
    w * (k / a) = R * (N / (2 * b * c)) := by
  have hk : k = a * b * c / (2 * R) := by
    rw [eq_div_iff (by positivity)]; linear_combination hRk
  have hN : N = w * b ^ 2 * c ^ 2 / R ^ 2 := by
    rw [eq_div_iff (by positivity)]; linear_combination -hw
  rw [hk, hN]
  field_simp

end Carnot
